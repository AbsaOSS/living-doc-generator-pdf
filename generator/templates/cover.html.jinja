<div class="cover-page">
    <div class="cover-content">
        <h1 class="document-title">{{ meta.document_title }}</h1>
        <div class="document-version">Version {{ meta.document_version }}</div>
        <div class="generated-at">Generated on {{ meta.generated_at | format_datetime }}</div>

        <div class="selection-summary">
            <h2>Selection Summary</h2>
            <div class="summary-stats">
                <div class="stat-item">
                    <span class="stat-label">Total Items:</span>
                    <span class="stat-value">{{ meta.selection_summary.total_items }}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Included:</span>
                    <span class="stat-value">{{ meta.selection_summary.included_items }}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Excluded:</span>
                    <span class="stat-value">{{ meta.selection_summary.excluded_items }}</span>
                </div>
            </div>
        </div>

        {% if meta.audit and meta.audit.source %}
        <div class="source-info">
            <h2>Sources</h2>
            {% if meta.audit.source.systems %}
            <div class="source-item">
                <span class="source-label">Systems:</span>
                <span class="source-value">{{ meta.audit.source.systems | join(', ') }}</span>
            </div>
            {% endif %}
            {% if meta.audit.source.organization %}
            <div class="source-item">
                <span class="source-label">Organization:</span>
                <span class="source-value">{{ meta.audit.source.organization }}</span>
            </div>
            {% endif %}
            {% if meta.audit.source.repositories %}
            <div class="source-item">
                <span class="source-label">Repositories:</span>
                <div class="source-repos">
                    {% for repo in meta.audit.source.repositories %}
                    <span class="source-repo">{{ repo }}</span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
        {% endif %}

        {% if meta.audit and meta.audit.producer %}
        <div class="producer-info">
            <span class="producer-label">Produced by</span>
            <span class="producer-value">{{ meta.audit.producer.name }} v{{ meta.audit.producer.version }}</span>
        </div>
        {% endif %}
    </div>
</div>
