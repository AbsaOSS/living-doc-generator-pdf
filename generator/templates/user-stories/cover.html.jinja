<section class="cover-page">
    <div class="cover-content">
        <h1 class="document-title">{{ meta.document_title }}</h1>
        <div class="generated-at">Generated on {{ meta.generated_at | format_datetime }}</div>
        <div class="source-file">Source: {{ meta.source_file }}</div>
        <div class="item-count">{{ items | length }} user stor{{ 'y' if items | length == 1 else 'ies' }}</div>
    </div>
</section>
