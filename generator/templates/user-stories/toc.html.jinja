<section class="toc">
    <h2 class="toc-title">Table of Contents</h2>
    <ul class="toc-list">
        {% for item in items %}
        {% set short_id = item.id.split('/') | last %}
        <li class="toc-entry">
            <a class="toc-link" href="#{{ short_id }}">
                <span class="toc-id">{{ short_id }}</span>
                <span class="toc-text">{{ item.title }}</span>
                {% if item.state %}
                <span class="toc-state state-{{ item.state | lower }}">{{ item.state }}</span>
                {% endif %}
            </a>
        </li>
        {% endfor %}
    </ul>
</section>
